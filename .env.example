# 로컬 개발용 DB 접속 정보. 이 파일을 .env로 복사한 뒤 값을 채운다.
SOM_DB_URL=
SOM_TEST_DB_URL=
SOM_DB_USER=
SOM_DB_PASSWORD=
SOM_ENGINE_MODE=mock
SOM_ENGINE_URL=http://127.0.0.1:8000
SOM_ENGINE_TOKEN=
SOM_CHAT_SEND_USER_TEXT_TO_ENGINE=false
SOM_CORS_ALLOWED_ORIGINS=http://localhost:3000
SOM_SESSION_COOKIE_SAME_SITE=lax
SOM_CSRF_CROSS_SITE=false

# Optional Google Calendar FreeBusy for the web app.
SOM_GOOGLE_CALENDAR_ENABLED=false
SOM_GOOGLE_CALENDAR_CLIENT_ID=
SOM_GOOGLE_CALENDAR_CLIENT_SECRET=
SOM_GOOGLE_CALENDAR_REDIRECT_URI=

# Web Push (optional). Set the same public key in browser pushManager.subscribe().
SOM_WEB_PUSH_ENABLED=false
SOM_WEB_PUSH_PUBLIC_KEY=
SOM_WEB_PUSH_PRIVATE_KEY=
SOM_WEB_PUSH_SUBJECT=
